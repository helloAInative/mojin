# 复制为 .env 后由 docker compose 读取。切勿提交真实 Key。
MJ_PORT=8787
RUST_LOG=mj_server=info,tower_http=info

# 阿里百炼 / Token Plan（仅存 NAS）
MJ_AI_API_KEY=
MJ_AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MJ_AI_MODEL=qwen-plus
MJ_AI_TIMEOUT_SECS=45

# 可分别覆盖五个角色的模型；留空时使用 MJ_AI_MODEL。
MJ_AI_MODEL_TECHNICIAN=
MJ_AI_MODEL_FUNDAMENTAL=
MJ_AI_MODEL_RISK=
MJ_AI_MODEL_POSITION=
MJ_AI_MODEL_PSYCHOLOGY=

# 可选 RSS：来源名|URL，多个来源用英文分号分隔；留空使用内置新闻搜索。
MJ_NEWS_FEEDS=
